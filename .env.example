# HostelMind-AI Environment Configuration

# Database (Neon / Supabase PostgreSQL + pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.neon.tech/hostelmind?sslmode=require
SPRING_DATASOURCE_USERNAME=neon_user
SPRING_DATASOURCE_PASSWORD=neon_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS & Deployment Domains
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://hostelmind-ai.vercel.app

# AI Provider Credentials (LangChain4j Abstraction)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# File Storage Provider (Cloudinary / Supabase Storage Adapter)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Environment Variables (for Vercel)
VITE_API_BASE_URL=https://hostelmind-backend.onrender.com/api/v1
